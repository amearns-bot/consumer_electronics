      <div data-analytics-action-title="What makes the Dyson CameraJet™ toothbrush different from other toothbrushes?" class="faq-q-and-a__accordion" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
         <div class="accordion__section faq-q-and-a__accordion-section">
               <a href="#" class="accordion__heading" data-aria-controls="93ac6856ee464429bb582259d60b3f27" data-analytics-action-name="accordion~heading">
                  <span class="faq-q-and-a__accordion-heading-text faq" itemprop="name">What makes the Dyson CameraJet™ toothbrush different from other toothbrushes?</span>
                  <svg class="shape shape--medium shape--chevron faq-q-and-a__accordion-heading--chevron" data-svg-href="/etc.clientlibs/dyson/clientlibs/clientlib-main/resources/icons/icons.sprite.svg#chevron" aria-hidden="true" data-analytics-action-name="accordion~shape">
                     <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="/etc.clientlibs/dyson/clientlibs/clientlib-main/resources/icons/icons.sprite.svg#chevron"></use>
