        (function () {
            var domain = getDomain(window.location.hostname);

            // OptanonConsent collects the user consent status from the OptanonConsent URL parameter
            // This determines the users accepted consent status
            var urlOptanonConsent = getQueryParameter("ot_consent");
            if (typeof (urlOptanonConsent) != "undefined" && urlOptanonConsent.length > 0) {
                setCookie("OptanonConsent", urlOptanonConsent, 365, domain);
            }

            // OptanonAlertBoxClosed determines whether the OneTrust script will display the consent banner
            var urlOptanonAlertBoxClosed = getQueryParameter("ot_abclosed");
            if (typeof (urlOptanonAlertBoxClosed) != "undefined" && urlOptanonAlertBoxClosed.length > 0) {
                setCookie("OptanonAlertBoxClosed", urlOptanonAlertBoxClosed, 365, domain);
            }

            // Get query parameter
            function getQueryParameter(paramName) {
                var url = window.location.href;
                var noFragment = (url.indexOf("#") !== -1) ? url.split("#")[0] : url;
                var queryParams = (noFragment.indexOf("?") !== -1) ? noFragment.split("?")[1] : noFragment;
                var pairs = queryParams.split("&");

                for (i = 0; i < pairs.length; i++) {
                    var name = pairs[i].split("=")[0];
                    var value = pairs[i].split("=")[1];

                    if (name.indexOf(paramName) !== -1) {
                        return value;
                    }
                }
            }

            function getDomain(hostname) {
                var domainParts = hostname.split(".");
                if (domainParts.length > 1) {
                    var tld = "";

                    // Handle multi-part TLDs
                    if (domainParts.length > 2 && (domainParts[domainParts.length - 2] === "com" || domainParts[domainParts.length - 2] === "co")) {
                        tld = domainParts[domainParts.length - 3] + "." + domainParts[domainParts.length - 2] + "." + domainParts[domainParts.length - 1];
                    } else {
                        // Handle single-part TLDs
                        tld = domainParts[domainParts.length - 2] + "." + domainParts[domainParts.length - 1];
                    }
                    return tld;
                }
            }

            // Set Cookie
            function setCookie(name, value, days, domain) {
                var expires = "";
                if (days) {
                    var date = new Date();
                    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                    expires = "; expires=" + date.toUTCString();
                }
                document.cookie = name + "=" + value + expires + ";domain=." + domain + "; path=/";
            }
        })();
    </script>
    
