      <div data-analytics-action-title="How does the Dyson CameraJet™ electric toothbrush work? " class="faq-q-and-a__accordion" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
         <div class="accordion__section faq-q-and-a__accordion-section">
